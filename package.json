{
  "name": "iqratime",
  "version": "1.7.2",
  "private": true,
  "author": "IqraTime",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "corpus:validate": "ts-node --project tsconfig.scripts.json scripts/validateCorpus.ts",
    "corpus:validate:prod": "CORPUS_ENV=production ts-node --project tsconfig.scripts.json scripts/validateCorpus.ts",
    "corpus:import": "ts-node --project tsconfig.scripts.json scripts/importTranslation.ts",
    "security:check-secrets": "ts-node --project tsconfig.scripts.json scripts/checkSecrets.ts",
    "prebuild": "expo prebuild",
    "check": "npm run typecheck && npm run lint && npm run test && npm run corpus:validate && npm run security:check-secrets"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-background-task": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.11",
    "expo-updates": "~57.0.15",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "^5.1.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
