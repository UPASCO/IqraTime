:{"en":"The Guide to the Right Path","fr":"Le Guide infaillible","de":"Der unfehlbare Führer","es":"El Guía infalible","it":"La Guida infallibile","nl":"De Onfeilbare Gids","pt":"O Guia infalível","ru":"Направляющий верно"}},{"number":99,"arabic":"الصبور","transliteration":"Aṣ-Ṣabūr","meaning":{"en":"The Timeless, The Patient","fr":"Le Très Patient","de":"Der Geduldige","es":"El Paciente","it":"Il Paziente","nl":"De Geduldige","pt":"O Paciente","ru":"Терпеливый"}}]}
