# AyahNow — example environment file.
#
# Copy to `.env` for local development if needed. Every value below is a
# safe placeholder — none of these are secrets, and this file must NEVER
# contain a real bank account/IBAN, a real Stripe secret key, or any other
# credential. See docs/STRIPE_SETUP.md for how the real Support payment
# URL is provided (via EAS environment configuration, not this file).
#
# All variables are EXPO_PUBLIC_* because Expo inlines them into the
# JS bundle at build time — meaning anything placed here is effectively
# public once the app is built. Never put a secret in an EXPO_PUBLIC_*
# variable, in this file or anywhere else in this project.

# --- "Support AyahNow" optional donation feature (see docs/STRIPE_SETUP.md) ---
# Ships disabled. Do not set to true without a real, validated Stripe
# Payment Link URL and the legal/religious/platform reviews below.
EXPO_PUBLIC_SUPPORT_ENABLED=false

# Placeholder only — the real Stripe Payment Link URL is provided via EAS
# environment configuration for production builds, never committed here.
EXPO_PUBLIC_SUPPORT_PAYMENT_URL=https://example.invalid/payment-link

EXPO_PUBLIC_SUPPORT_PROVIDER_NAME=Stripe

# Set to true only after the corresponding human review is actually done.
EXPO_PUBLIC_SUPPORT_LEGAL_REVIEWED=false
EXPO_PUBLIC_SUPPORT_RELIGIOUS_REVIEWED=false
EXPO_PUBLIC_SUPPORT_IOS_APPROVED=false
EXPO_PUBLIC_SUPPORT_ANDROID_APPROVED=false

# Optional: only set this if using a Stripe custom domain for Payment Links.
# EXPO_PUBLIC_SUPPORT_ALLOWED_HOST=pay.example.org

# --- Corpus build gating (see docs/CORPUS.md) ---
# "development" (default) allows the demo/draft corpus; "production"
# blocks the build unless the corpus is fully validated and publishable.
EXPO_PUBLIC_CORPUS_ENV=development
