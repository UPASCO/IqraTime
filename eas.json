{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CORPUS_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CORPUS_ENV": "development",
        "_comment_support": "Internal test builds only. The URL below is a placeholder on Stripe's domain, not a working Payment Link, and the four review flags are forced true purely so the Support screen renders in its available state on device. The production profile deliberately sets none of this: see docs/RELEASE_CHECKLIST.md.",
        "EXPO_PUBLIC_SUPPORT_ENABLED": "true",
        "EXPO_PUBLIC_SUPPORT_PAYMENT_URL": "https://buy.stripe.com/test_00000000000000",
        "EXPO_PUBLIC_SUPPORT_PROVIDER_NAME": "Stripe",
        "EXPO_PUBLIC_SUPPORT_LEGAL_REVIEWED": "true",
        "EXPO_PUBLIC_SUPPORT_RELIGIOUS_REVIEWED": "true",
        "EXPO_PUBLIC_SUPPORT_IOS_APPROVED": "true",
        "EXPO_PUBLIC_SUPPORT_ANDROID_APPROVED": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CORPUS_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_REAL_APP_STORE_CONNECT_ID"
      },
      "android": {
        "serviceAccountKeyPath": "REPLACE_WITH_PATH_TO_SERVICE_ACCOUNT_JSON",
        "track": "internal"
      }
    }
  }
}
